        // Corridor kit (composite, WallAstra skin)
        // 4x4 modular grid. Chain corridor_straight by translating the placed entity (0,0,4) per
        // segment. Wall triplet (bottommetal_straight + wallastra_straight + topastra_straight)
        // shares one origin/rotation: rotation 0 = west edge, rotation 180 = east edge (mirrored),
        // per the WallAstra off-center-mesh convention.
        "corridor_straight": (
            kind: Primitive,
            model: "",
            components: (),
            children: [
                ( prefab: "platform_simple", offset: (0.0, 0.0, 0.0) ),
                // West wall triplet
                ( prefab: "bottommetal_straight", offset: (0.0, 0.0, 0.0), rotation_euler_deg: (0.0, 0.0, 0.0) ),
                ( prefab: "wallastra_straight", offset: (0.0, 0.0, 0.0), rotation_euler_deg: (0.0, 0.0, 0.0) ),
                ( prefab: "topastra_straight", offset: (0.0, 0.0, 0.0), rotation_euler_deg: (0.0, 0.0, 0.0) ),
                // East wall triplet (mirrored 180 deg around Y)
                ( prefab: "bottommetal_straight", offset: (0.0, 0.0, 0.0), rotation_euler_deg: (0.0, 180.0, 0.0) ),
                ( prefab: "wallastra_straight", offset: (0.0, 0.0, 0.0), rotation_euler_deg: (0.0, 180.0, 0.0) ),
                ( prefab: "topastra_straight", offset: (0.0, 0.0, 0.0), rotation_euler_deg: (0.0, 180.0, 0.0) ),
            ],
        ),

        // Single 4x4 turn tile using the "outer" (convex) corner wall set alone -- SW quadrant,
        // closes the west+south edges, leaves north+east open as the through-path. One corner
        // mesh set is sufficient for a valid 90-degree turn (2 open, perpendicular edges); the
        // "inner" corner meshes (wallastra_corner_square_inner + bottommetal_corner_square_inner +
        // topastra_corner_round_inner) are a same-footprint alternate corner style, not a
        // complement to stack alongside this one -- stacking both at the same origin would double
        // up overlapping wall geometry and z-fight. Try the inner set as a separate
        // `corridor_corner_inner` variant if the outer style doesn't read right in-browser.
        "corridor_corner": (
            kind: Primitive,
            model: "",
            components: (),
            children: [
                ( prefab: "platform_simple", offset: (0.0, 0.0, 0.0) ),
                ( prefab: "bottommetal_corner_square_outer_1", offset: (0.0, 0.0, 0.0), rotation_euler_deg: (0.0, 0.0, 0.0) ),
                ( prefab: "wallastra_corner_square_outer", offset: (0.0, 0.0, 0.0), rotation_euler_deg: (0.0, 0.0, 0.0) ),
                ( prefab: "topastra_curve_round_outer", offset: (0.0, 0.0, 0.0), rotation_euler_deg: (0.0, 0.0, 0.0) ),
            ],
        ),

        // Same as corridor_straight, but the east wall triplet is replaced by a door frame insert
        // (west side stays a solid wall; east side has a door-sized opening). Door leaf open/close
        // FSM is out of scope for this pass -- frame only, treated as open/decorative.
        "corridor_doorway": (
            kind: Primitive,
            model: "",
            components: (),
            children: [
                ( prefab: "platform_simple", offset: (0.0, 0.0, 0.0) ),
                // West wall triplet (solid)
                ( prefab: "bottommetal_straight", offset: (0.0, 0.0, 0.0), rotation_euler_deg: (0.0, 0.0, 0.0) ),
                ( prefab: "wallastra_straight", offset: (0.0, 0.0, 0.0), rotation_euler_deg: (0.0, 0.0, 0.0) ),
                ( prefab: "topastra_straight", offset: (0.0, 0.0, 0.0), rotation_euler_deg: (0.0, 0.0, 0.0) ),
                // East side: door frame insert instead of a solid wall triplet
                ( prefab: "door_frame_square", offset: (0.0, 0.0, 0.0), rotation_euler_deg: (0.0, 180.0, 0.0) ),
            ],
        ),

        // Dead end: walls on west+east+south, north left open as the incoming direction (matches
        // corridor_straight's open axis so it can cap a chain of straight segments).
        "corridor_end_cap": (
            kind: Primitive,
            model: "",
            components: (),
            children: [
                ( prefab: "platform_simple", offset: (0.0, 0.0, 0.0) ),
                // West wall triplet
                ( prefab: "bottommetal_straight", offset: (0.0, 0.0, 0.0), rotation_euler_deg: (0.0, 0.0, 0.0) ),
                ( prefab: "wallastra_straight", offset: (0.0, 0.0, 0.0), rotation_euler_deg: (0.0, 0.0, 0.0) ),
                ( prefab: "topastra_straight", offset: (0.0, 0.0, 0.0), rotation_euler_deg: (0.0, 0.0, 0.0) ),
                // East wall triplet
                ( prefab: "bottommetal_straight", offset: (0.0, 0.0, 0.0), rotation_euler_deg: (0.0, 180.0, 0.0) ),
                ( prefab: "wallastra_straight", offset: (0.0, 0.0, 0.0), rotation_euler_deg: (0.0, 180.0, 0.0) ),
                ( prefab: "topastra_straight", offset: (0.0, 0.0, 0.0), rotation_euler_deg: (0.0, 180.0, 0.0) ),
                // South wall triplet (caps the segment; north stays open as the incoming direction)
                ( prefab: "bottommetal_straight", offset: (0.0, 0.0, 0.0), rotation_euler_deg: (0.0, 90.0, 0.0) ),
                ( prefab: "wallastra_straight", offset: (0.0, 0.0, 0.0), rotation_euler_deg: (0.0, 90.0, 0.0) ),
                ( prefab: "topastra_straight", offset: (0.0, 0.0, 0.0), rotation_euler_deg: (0.0, 90.0, 0.0) ),
            ],
        ),

    }
