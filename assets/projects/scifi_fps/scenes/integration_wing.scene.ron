(
    schema_version: 2,
    name: "integration_wing",

    lighting: (
        ambient: (0.14, 0.16, 0.22),
        ambient_brightness: 180.0,
        directional: (
            color: (0.85, 0.90, 1.0),
            intensity: 22000.0,
            rotation_euler_deg: (-50.0, 25.0, 0.0),
            shadows_enabled: true,
            shadow_distance: 60.0,
            cascade_overlap: 0.5,
        ),
    ),

    spawn_points: {
        "player_start": (0.0, 0.5, 1.0),
    },

    entities: [

        // Safety-net ground plane below the whole layout.
        (
            id: "safety_ground",
            prefab: "ground",
            transform: (
                translation: (10.0, -1.0, 8.0),
                rotation_euler_deg: (0.0, 0.0, 0.0),
                scale: (1.0, 1.0, 1.0),
            ),
        ),

        // --- Spine: entrance -> [doorway -> room] x3 -> end_cap, all along +Z at x=0.
        // Each room's entrance (tile (0,0)'s west edge) is placed at translation
        // (4, 0, doorway_z), identity rotation -- the doorway at spine z=doorway_z
        // opens at world x=2, z:[doorway_z-2, doorway_z+2], which is exactly where the
        // room's tile (0,0) west edge (local x:[-2,2] z:[-2,2]) lands after that
        // translation. No rotation guess: only values already proven by the corridor
        // kit are reused (0/90/180/270 for west/south/east/north). See prefabs.ron for
        // why the entrance is one tile wide, not two (the original "half blocked" bug).
        (
            id: "spine_entrance",
            prefab: "corridor_straight",
            transform: ( translation: (0.0, 0.0, 0.0), rotation_euler_deg: (0.0, 0.0, 0.0), scale: (1.0, 1.0, 1.0) ),
        ),
        (
            id: "spine_doorway_1",
            prefab: "corridor_doorway",
            transform: ( translation: (0.0, 0.0, 4.0), rotation_euler_deg: (0.0, 0.0, 0.0), scale: (1.0, 1.0, 1.0) ),
        ),
        (
            id: "room_suit_bay_1",
            prefab: "room_suit_bay",
            transform: ( translation: (4.0, 0.0, 4.0), rotation_euler_deg: (0.0, 0.0, 0.0), scale: (1.0, 1.0, 1.0) ),
            label: (text: "Suit Bay"),
        ),
        (
            id: "spine_straight_2",
            prefab: "corridor_straight",
            transform: ( translation: (0.0, 0.0, 8.0), rotation_euler_deg: (0.0, 0.0, 0.0), scale: (1.0, 1.0, 1.0) ),
        ),
        (
            id: "spine_doorway_2",
            prefab: "corridor_doorway",
            transform: ( translation: (0.0, 0.0, 12.0), rotation_euler_deg: (0.0, 0.0, 0.0), scale: (1.0, 1.0, 1.0) ),
        ),
        (
            id: "room_briefing_1",
            prefab: "room_briefing",
            transform: ( translation: (4.0, 0.0, 12.0), rotation_euler_deg: (0.0, 0.0, 0.0), scale: (1.0, 1.0, 1.0) ),
            label: (text: "Briefing Room"),
        ),

        // Proximity trigger for the Mission 1 ("Survey") briefing pop-up. room_briefing_1
        // is placed at (4,0,12); its own local children span x:[-2,6] z:[-2,6], so the
        // room's world footprint is x:[2,10] z:[10,18] with the entrance (open west edge)
        // at x:[2,6]. This trigger sits near the briefing table (local table offset
        // (2.0, 0.451, 1.0) -> world (6.0, 0.451, 13.0)), radius 3.2 keeps it clear of the
        // x=2 boundary so it does not bleed back into the corridor/doorway.
        (
            id: "briefing_trigger",
            prefab: "trigger_briefing_intel",
            transform: ( translation: (6.0, 1.0, 13.0), rotation_euler_deg: (0.0, 0.0, 0.0), scale: (1.0, 1.0, 1.0) ),
        ),

        (
            id: "spine_straight_3",
            prefab: "corridor_straight",
            transform: ( translation: (0.0, 0.0, 16.0), rotation_euler_deg: (0.0, 0.0, 0.0), scale: (1.0, 1.0, 1.0) ),
        ),
        (
            id: "spine_doorway_3",
            prefab: "corridor_doorway",
            transform: ( translation: (0.0, 0.0, 20.0), rotation_euler_deg: (0.0, 0.0, 0.0), scale: (1.0, 1.0, 1.0) ),
        ),
        (
            id: "room_armory_1",
            prefab: "room_armory",
            transform: ( translation: (4.0, 0.0, 20.0), rotation_euler_deg: (0.0, 0.0, 0.0), scale: (1.0, 1.0, 1.0) ),
            label: (text: "Armory"),
        ),
        (
            id: "spine_straight_4",
            prefab: "corridor_straight",
            transform: ( translation: (0.0, 0.0, 24.0), rotation_euler_deg: (0.0, 0.0, 0.0), scale: (1.0, 1.0, 1.0) ),
        ),
        (
            id: "spine_doorway_4",
            prefab: "corridor_doorway",
            transform: ( translation: (0.0, 0.0, 28.0), rotation_euler_deg: (0.0, 0.0, 0.0), scale: (1.0, 1.0, 1.0) ),
        ),
        (
            id: "room_observation_deck_1",
            prefab: "room_observation_deck",
            transform: ( translation: (4.0, 0.0, 28.0), rotation_euler_deg: (0.0, 0.0, 0.0), scale: (1.0, 1.0, 1.0) ),
            label: (text: "Observation Deck"),
        ),
        (
            id: "spine_end_cap",
            prefab: "corridor_end_cap",
            transform: ( translation: (0.0, 0.0, 32.0), rotation_euler_deg: (0.0, 0.0, 0.0), scale: (1.0, 1.0, 1.0) ),
        ),

        // Player capsule -- orbit camera, spawns in the spine entrance segment.
        (
            id: "player_01",
            prefab: "player",
            transform: ( translation: (0.0, 0.5, 1.0), rotation_euler_deg: (0.0, 0.0, 0.0), scale: (1.0, 1.0, 1.0) ),
        ),

    ],

    ui: [],
)
