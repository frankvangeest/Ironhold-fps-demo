(
    schema_version: 2,
    name: "corridor_blockout",

    lighting: (
        ambient: (0.14, 0.16, 0.22),
        ambient_brightness: 180.0,
        directional: (
            color: (0.85, 0.90, 1.0),
            intensity: 22000.0,
            rotation_euler_deg: (-50.0, 25.0, 0.0),
            shadows_enabled: true,
            shadow_distance: 60.0,
            cascade_overlap: 0.5,
        ),
    ),

    spawn_points: {
        "player_start": (0.0, 0.5, 1.0),
    },

    entities: [

        // Safety-net ground plane below the whole layout -- catches the player if a
        // spawn point or a gap between corridor tiles isn't perfectly covered, instead
        // of an infinite fall. Covers hallway (z: 0..16) + corner test area (x: 0..24).
        (
            id: "safety_ground",
            prefab: "ground",
            transform: (
                translation: (10.0, -1.0, 8.0),
                rotation_euler_deg: (0.0, 0.0, 0.0),
                scale: (1.0, 1.0, 1.0),
            ),
        ),

        // --- Main hallway: straight x2 -> doorway -> end_cap, chained along +Z.
        // Player spawns at the open south end and walks north into the dead end.
        // Verifies: wall collision blocks the player, the doorway opening is
        // actually passable, tiles butt seamlessly with no gap/overlap.
        (
            id: "hall_straight_1",
            prefab: "corridor_straight",
            transform: ( translation: (0.0, 0.0, 0.0), rotation_euler_deg: (0.0, 0.0, 0.0), scale: (1.0, 1.0, 1.0) ),
        ),
        (
            id: "hall_straight_2",
            prefab: "corridor_straight",
            transform: ( translation: (0.0, 0.0, 4.0), rotation_euler_deg: (0.0, 0.0, 0.0), scale: (1.0, 1.0, 1.0) ),
        ),
        (
            id: "hall_doorway",
            prefab: "corridor_doorway",
            transform: ( translation: (0.0, 0.0, 8.0), rotation_euler_deg: (0.0, 0.0, 0.0), scale: (1.0, 1.0, 1.0) ),
        ),
        (
            id: "hall_end_cap",
            prefab: "corridor_end_cap",
            transform: ( translation: (0.0, 0.0, 12.0), rotation_euler_deg: (0.0, 0.0, 0.0), scale: (1.0, 1.0, 1.0) ),
        ),

        // --- Isolated corner tile for visual inspection only (not chained to anything
        // yet -- geometry alignment for corridor_corner is unverified, see
        // planning/feature_request.md notes / prefab comments). Look at which two
        // edges are actually open before wiring it into a chained turn.
        (
            id: "corner_test",
            prefab: "corridor_corner",
            transform: ( translation: (16.0, 0.0, 0.0), rotation_euler_deg: (0.0, 0.0, 0.0), scale: (1.0, 1.0, 1.0) ),
            label: (text: "corridor_corner (check open edges)"),
        ),

        // --- Scale reference / dressing
        (
            id: "column_ref",
            prefab: "column_round",
            transform: ( translation: (16.0, 0.0, 6.0), rotation_euler_deg: (0.0, 0.0, 0.0), scale: (1.0, 1.0, 1.0) ),
        ),
        (
            id: "crate_ref_1",
            prefab: "prop_crate3",
            transform: ( translation: (1.2, 0.001, 2.0), rotation_euler_deg: (0.0, 15.0, 0.0), scale: (1.0, 1.0, 1.0) ),
        ),
        (
            id: "light_ref_1",
            prefab: "prop_light_wide",
            transform: ( translation: (-1.6, 2.6, 2.0), rotation_euler_deg: (0.0, 90.0, 0.0), scale: (1.0, 1.0, 1.0) ),
        ),

        // Player capsule -- orbit camera, tests wall/doorway collision directly.
        (
            id: "player_01",
            prefab: "player",
            transform: ( translation: (0.0, 0.5, 1.0), rotation_euler_deg: (0.0, 0.0, 0.0), scale: (1.0, 1.0, 1.0) ),
        ),

    ],

    ui: [],
)
